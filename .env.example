# Copy this file to `.env.local` for local development.
# All variables marked with * are REQUIRED for the app to work.

# * PostgreSQL connection string (Supabase Transaction Pooler recommended)
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# * JWT secret — minimum 32 characters, change in production
JWT_SECRET="change-me-to-something-long-and-random-at-least-32-chars"

# JWT token duration in seconds (default: 28800 = 8 hours)
JWT_EXPIRES_IN="28800"

# * Public app URL — set to your Vercel domain in production
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Optional: Webhook URL to notify on purchase request approval (HU-30)
# WEBHOOK_URL="https://your-system.com/webhook"

# Optional: Upstash Redis for production rate limiting (HU-21)
# UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token"
